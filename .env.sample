SAASUS_SECRET_KEY=
SAASUS_API_KEY=
SAASUS_SAAS_ID=
SAASUS_BASE_URL=

# AWS認証情報（Cognito統合に必須）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cognito設定（E2Eテストに必須）
E2E_COGNITO_USER_POOL_ID=
E2E_COGNITO_CLIENT_ID=
E2E_COGNITO_REGION=ap-northeast-1
E2E_COGNITO_USERNAME=
E2E_COGNITO_PASSWORD=

# 外部統合（オプション）
STRIPE_SECRET_KEY=
AWS_MARKETPLACE_REGISTRATION_TOKEN=

# テスト設定（オプション）
AUTH_E2E_DEFAULT_PASSWORD=Passw0rd!
DRY_RUN=false
LOG_LEVEL=INFO

# スナップショット設定（オプション）
SNAPSHOT_MODE=capture
SNAPSHOT_ENABLED=true
SNAPSHOT_DIR=tests/snapshots
